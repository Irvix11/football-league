# Optional frontend-only override when the frontend is hosted separately from the game server.
# Leave unset when the Node server serves both the frontend and the game API/WebSocket.
VITE_GAME_SERVER_URL=""

# Supabase persistence
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# OpenRouter AI (server-side only; never expose this key with VITE_*)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openrouter/auto"
OPENROUTER_SITE_URL="https://football-league-nine.vercel.app"

# Optional comma-separated WebSocket Origin allowlist for production.
# Leave unset to allow only the exact HTTP(S) origin used by the server.
ALLOWED_WS_ORIGINS="https://football-league-nine.vercel.app"
